{
    "name": "mborne/remote-git",
    "type": "library",
    "description": "A lightweight PHP client providing a consistent way to find hosted and self-hosted git repositories (github, gitlab,...)",
    "license": "MIT",
    "authors": [
        {
            "name": "Mickaël BORNE",
            "email": "mborne@users.noreply.github.com"
        }
    ],
    "autoload": {
        "psr-4": {"MBO\\RemoteGit\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {
            "MBO\\RemoteGit\\Tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "~7.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-coveralls/php-coveralls": "^2.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": [
            "@check-style",
            "@check-rules",
            "@phpunit"
        ],
        "phpunit": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "echo -- Running phpunit... See output/coverage/index.html",
            "phpunit -c phpunit.xml.dist --log-junit output/junit-report.xml --coverage-clover output/clover.xml --coverage-html output/coverage"
        ],
        "check-rules": [
            "@phpstan"
        ],
        "phpstan": [
            "phpstan analyse -c phpstan.neon --error-format=raw"
        ],
        "check-style": [
            "echo -- Checking coding style using php-cs-fixer, run composer fix-style if it fails",
            "php-cs-fixer fix src --rules @Symfony,-global_namespace_import -v --dry-run --diff",
            "php-cs-fixer fix tests --rules @Symfony,-global_namespace_import -v --dry-run --diff"
        ],
        "fix-style": [
            "echo -- Fixing coding style using php-cs-fixer...",
            "php-cs-fixer fix src --rules @Symfony,-global_namespace_import",
            "php-cs-fixer fix tests --rules @Symfony,-global_namespace_import"
        ]
    },
    "scripts-descriptions": {
        "test": "Check coding style, run static analysis and run tests",
        "phpunit": "Run tests with coverage report to output/coverage/index.html",
        "check-rules": "Run static analysis using phpstan",
        "phpstan": "Run static analysis using phpstan",
        "check-style": "Check coding style using php-cs-fixer",
        "fix-style": "Fix coding style using php-cs-fixer"
    }
}
